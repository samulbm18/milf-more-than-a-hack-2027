# This repository will be public. The match data, anything derived from it row by row, and every
# label file must never be committed. When in doubt, add it here first.

# -- data and derived arrays ---------------------------------------------------------------------
data/
cache/
runs/
outputs/
*.npy
*.npz
*.csv
*.parquet
*.pkl
*.mp4
*.txt.gz
*.xml

